# Dedicated plugin key shared ONLY with the new DealDesk backend endpoint.
# Generate locally with: openssl rand -hex 32
DEALDESK_PLUGIN_API_KEY=
DEALDESK_PLUGIN_URL=https://dealdesk.asharizakargroup.com/api/ai/plugin
DEALDESK_PLUGIN_WRITES=false
DEALDESK_PLUGIN_ARCHIVE=false
DEALDESK_PRINCIPAL=local-operator
DEALDESK_TRANSPORT=stdio
# HTTP development transport only (otherwise leave empty):
DEALDESK_MCP_TOKEN=
PORT=8787

# Configure on the DealDesk BACKEND, not in the MCP client:
# DEALDESK_PLUGIN_ORGANIZATION_ID=<your actual organization_id>
# VITE_SUPABASE_URL=<existing backend value>
# SUPABASE_SERVICE_ROLE_KEY=<existing backend value>
# DEALDESK_PLUGIN_API_KEY=<same dedicated plugin key>
# DEALDESK_PLUGIN_WRITES=false
# DEALDESK_PLUGIN_ARCHIVE=false
