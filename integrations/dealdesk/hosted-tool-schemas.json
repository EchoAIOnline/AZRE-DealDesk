  {
    "name": "add_deal_note",
    "description": "Append a timestamped ChatGPT-attributed note without replacing history. Concurrent appends are serialized. Never deletes notes.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "deal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
