              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "status": {
              "type": "string",
              "enum": [
                "Open",
                "Completed"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "Low",
                "Normal",
                "High",
                "Urgent"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
