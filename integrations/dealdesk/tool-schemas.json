  {
    "name": "create_deal",
    "description": "Create a deal. Use a fresh UUID request_id once per intended creation and reuse it if retrying. ",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "fields": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "mls": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "listPrice": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "offerPrice": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "agentName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "agentPhone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "agentEmail": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "agentBrokerage": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "acquisitionManager": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "offerDecision": {
              "type": "string",
              "enum": [
                "No Offer Made Yet",
                "Seller Counter-Offered",
                "Monitoring Pending Status Before Offer",
                "Requires A Buyers Agent",
                "Made Verbal Offer On Property",
                "Made Written Offer On Property",
                "Monitoring Pending Status After Offer",
                "Monitoring Offer After Seller Declined",
                "Analyzing",
                "Seller Accepted Offer",
                "Agent Sending Contract",
                "Deal Under Contract",
                "Listing Removed - Now Off Market",
                "Offer Declined",
                "Offer Declined and Sold",
                "Sold To Another Investor",
                "Deal Canceled",
                "Priced Too High To Buy",
                "No Longer Interested In Buying",
                "Declined",
                "Deal No Longer Available",
                "Deal Successfully Closed"
              ]
            },
            "subMarket": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "neighborhood": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "county": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "dealType": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "propertyType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "listingDescription": {
              "type": "string",
              "maxLength": 10000
            },
            "originalAskingPrice": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "reducedAskingPrice": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "negotiatedAskingPrice": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "desiredWholesaleProfit": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "renovationEstimate": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "newConstructionEstimate": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "renovationARV": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "newConstructionARV": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "bedrooms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "bathrooms": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "sqft": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "lotSqft": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000000
            },
            "yearBuilt": {
              "type": "integer",
              "minimum": 1600,
              "maximum": 2200
            },
            "nextFollowUpDate": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastContactDate": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "interestLevel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "contactStatus": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "address"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "fields"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
