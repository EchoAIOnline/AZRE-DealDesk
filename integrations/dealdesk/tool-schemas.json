                  "maxLength": 2000
                },
                "minPrice": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000000000
                },
                "maxPrice": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000000000
                },
                "minArv": {
                  "type": "number",
                  "minimum": 0,
